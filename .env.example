# fake = built-in demo exchange, bybit = Bybit testnet
EXCHANGE=fake
# Private-server Bearer token, at least 16 chars; optional only for PUBLIC_DEMO=1 with EXCHANGE=fake.
APP_TOKEN=
PORT=8787
HOST=127.0.0.1
# Only testnet or demo hosts are accepted.
BYBIT_BASE=https://api-testnet.bybit.com
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Speech-to-text for yes/no answers. Leave empty to turn voice off. With voice answers enabled, actionable alerts can open the G2 mic automatically.
OPENAI_API_KEY=
# Dev only: lets the local app connect without typing the token. Never set it for a build you share.
VITE_APP_TOKEN=
# Public hosted paper demo only. Allows anonymous API access, but only with EXCHANGE=fake; disables voice.
PUBLIC_DEMO=0
