# fake = built-in demo exchange, bybit = Bybit testnet
EXCHANGE=fake
# Shared secret the glasses app sends as a Bearer token. Required, 16+ characters: openssl rand -hex 16
APP_TOKEN=
PORT=8787
HOST=127.0.0.1
# Only testnet or demo hosts are accepted.
BYBIT_BASE=https://api-testnet.bybit.com
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Voice shortcuts: speech-to-text. Leave empty to turn voice off. Audio is sent only after a tap.
OPENAI_API_KEY=
# Alerts to Telegram when the glasses are off (optional). Create a bot with @BotFather; link it in the app: Settings › Telegram.
TELEGRAM_BOT_TOKEN=
# Dev only: lets the local app connect without typing the token. Never set it for a build you share.
VITE_APP_TOKEN=
