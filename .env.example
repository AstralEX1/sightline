# fake = built-in demo exchange, bybit = Bybit testnet
EXCHANGE=fake
# Shared secret the glasses app sends as a Bearer token. Required, 16+ characters: openssl rand -hex 16
APP_TOKEN=
PORT=8787
HOST=127.0.0.1
# Only testnet or demo hosts are accepted.
BYBIT_BASE=https://api-testnet.bybit.com
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Speech-to-text for yes/no answers. Leave empty to turn voice off. With voice answers enabled, actionable alerts can open the G2 mic automatically.
OPENAI_API_KEY=
# Dev only: lets the local app connect without typing the token. Never set it for a build you share.
VITE_APP_TOKEN=
# Public hosted paper demo only. Use EXCHANGE=fake and a separate APP_TOKEN; this mode disables voice.
PUBLIC_DEMO=0
# Optional build-time value for a hosted phone demo. It is public and must match only the demo's APP_TOKEN.
VITE_DEMO_TOKEN=
